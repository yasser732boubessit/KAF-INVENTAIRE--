{
  "name": "kaf-inventaire",
  "private": true,
  "version": "1.0.0",
  "description": "KAF-INVENTAIRE - Frontend + Desktop (Electron) + Server (Express)",
  "author": "KAF Inventaire Engineering Team",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "tsx server.ts",
    "server": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview --port=3000",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true,force:true});require('fs').rmSync('dist-electron', {recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --external:better-sqlite3 --external:sqlite3 --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "electron:dev": "npm run build:electron && concurrently -k \"vite --port=3000 --strictPort\" \"wait-on tcp:3000 && electron .\"",
    "electron:start": "npm run build:electron && electron .",
    "electron:build:win": "vite build && npm run build:electron && electron-builder --win --x64",
    "electron:pack": "vite build && npm run build:electron && electron-builder --dir",
    "start:all": "concurrently -k -n SERVER,VITE,ELECTRON -c blue,green,yellow \"npm run start\" \"vite --port=3000 --strictPort\" \"wait-on tcp:5000 tcp:3000 && electron .\"",
    "backend:dev": "cd backend && npm run start:dev",
    "backend:build": "cd backend && npm run build",
    "backend:prisma:generate": "cd backend && npm run prisma:generate",
    "backend:prisma:migrate": "cd backend && npm run prisma:migrate",
    "backend:prisma:seed": "cd backend && npm run prisma:seed",
    "backend:docker:up": "cd backend && docker compose up -d",
    "backend:docker:down": "cd backend && docker compose down"
  },
  "build": {
    "appId": "com.kafinventaire.desktop",
    "productName": "KAF-INVENTAIRE",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KAF-INVENTAIRE"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.3.3",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
